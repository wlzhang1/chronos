# ============================================================================
# CHRONOS – KONFIGURATIONSVORLAGE (.env.example)
# ============================================================================
# ANLEITUNG:
# 1. Kopiere diese Datei im selben Ordner und nenne die Kopie: .env
# 2. Ersetze die untenstehenden Test-Werte durch deine eigenen Schlüssel.
#    (WICHTIG: Lade deine echte .env niemals auf GitHub hoch!)
# ============================================================================

# --- 1. Google Gemini KI (100% kostenlos über Google AI Studio) ---
# Hole deinen Key hier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="DEIN_GEMINI_API_KEY_HIER_EINTRAGEN"

# Standard-KI-Modell (Chronos wechselt automatisch auf Alternativen, falls nötig)
GEMINI_MODEL="gemini-2.5-flash"


# --- 2. Google Calendar OAuth2 (100% kostenlos über Google Cloud Console) ---
# Erstelle deine OAuth-Client-ID hier: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="123456789012-beispielclientid.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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345"

# Diese Redirect-URI muss exakt so auch in der Google Cloud Console hinterlegt sein:
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/callback"


# --- 3. Server-Einstellungen (Standardwerte können so bleiben) ---
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"
